/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ]
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  // The shared submodule ships its own specs (some import Angular Material /
  // Form.io, which this app does not install) - they run in the admin and
  // reader Karma suites, not here.
  "exclude": [
    "src/common/**"
  ]
}
