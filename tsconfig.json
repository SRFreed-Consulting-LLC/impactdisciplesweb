/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    // src/common is the git submodule shared with the admin and reader apps
    // (impact-discipleship-library-common) - same alias those two use.
    //
    // 'src/*' replaces the baseUrl dropped 2026-08-26: TypeScript deprecated
    // baseUrl and 6.0+ reports it as an error in the editor ("will stop
    // functioning in TypeScript 7.0"), though the 5.8 pinned here still
    // accepts it. It was load-bearing - 176 imports in this app are written
    // bare as 'src/app/...' rather than relatively - so it becomes an
    // explicit mapping rather than a deletion. Since TS 4.4 `paths` resolve
    // relative to this file, so no baseUrl is needed.
    "paths": {
      "@impact-common/*": ["./src/common/src/*"],
      "src/*": ["./src/*"]
    },
    // Added 2026-08-29 so nav-menu-data.spec.ts can import the shared
    // site-navigation-seed.json and prove the seeded menu converts to
    // exactly what the site renders today. Without it that proof would have
    // to be a hand-copied fixture, which would agree with itself forever.
    "resolveJsonModule": true,
    // Its companion, and needed for the same one import: a JSON module has
    // only a default export as far as the bundler is concerned, so the spec
    // must default-import it - and without this flag TypeScript rejects that
    // while the bundler rejects the namespace form. Type-checking only; it
    // changes no emitted code.
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    // strict is the family switch, and until 2026-09-05 the two flags that
    // carry most of it were turned back off below (noImplicitAny and
    // strictNullChecks). CLAUDE.md used to say re-enabling them "surfaces
    // ~900 pre-existing compile errors"; measured, it was 157 in the app
    // and one in the specs - thirteen untyped fromFirestore hooks in the
    // DAO, a cluster in the shipping and schedule services, and the store.
    // Among them: getById() resolving undefined behind a Promise<T>, an
    // event with no end date blanking BOTH event lists, and a schedule
    // page that went blank on an event with no location. Both stay on.
    //
    // strictPropertyInitialization is the one still off: a different kind
    // of work (every @Input and lifecycle-filled field), tracked separately.
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
