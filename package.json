{
  "name": "impactdisciplesweb",
  "version": "0.0.0",
  "scripts": {
    "start-local": "ng serve --configuration=local --port=4200",
    "build-local": "ng build --configuration=local",
    "start-dev": "ng serve --configuration=development --port=4200",
    "build-dev": "ng build --configuration=development",
    "build-deploy-dev": "ng build --configuration=development && firebase use impactdisciplesdev && firebase deploy --only hosting:development",
    "start-prod": "ng serve --configuration=production --port=4200",
    "build-prod": "ng build --configuration=production",
    "build-deploy-prod": "ng build --configuration=production && firebase use impactdisciples-a82a8 && firebase deploy --only hosting:production",
    "lint": "ng lint",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "start-emu": "ng serve --configuration=emulator --port=4201",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "coverage:check": "node scripts/check-coverage.js",
    "coverage:baseline": "node scripts/check-coverage.js --update"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@angular/youtube-player": "^20.2.14",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.7",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "ngx-paypal": "^11.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^12.2.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.27",
    "@playwright/test": "^1.62.1",
    "@types/bootstrap": "^5.2.11",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "image-size": "^1.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
