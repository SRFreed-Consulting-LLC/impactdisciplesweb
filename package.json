{
  "name": "impactdisciplesweb",
  "version": "0.0.0",
  "scripts": {
    "start-local": "ng serve --configuration=local",
    "build-local": "ng build --configuration=local",
    "start-dev": "ng serve --configuration=development",
    "build-dev": "ng build --configuration=development",
    "build-deploy-dev": "ng build --configuration=development && firebase use impactdisciplesdev && firebase deploy --only hosting:development",
    "start-prod": "ng serve --configuration=production",
    "build-prod": "ng build --configuration=production",
    "build-deploy-prod": "ng build --configuration=production && firebase use impactdisciples-a82a8 && firebase deploy --only hosting:production",
    "add-git-submodule": "git submodule add -b development https://github.com/SRFreed-Consulting-LLC/impactdisciplescommon.git",
    "init-git-submodules": "git submodule update --init --recursive && git submodule status --recursive",
    "add-git-pwa-submodule": "git submodule add -b main https://github.com/SRFreed-Consulting-LLC/impactdisciplespwacommon.git",
    "init-git-pwa-submodules": "git submodule update --init --recursive && git submodule status --recursive"
  },
  "private": true,
  "dependencies": {
    "@angular-slider/ngx-slider": "^19.0.0",
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/youtube-player": "^19.2.19",
    "@google-cloud/firestore": "^7.9.0",
    "@ngxs/devtools-plugin": "^19.0.0",
    "@ngxs/store": "^19.0.0",
    "@stripe/stripe-js": "^4.3.0",
    "bootstrap": "^5.3.7",
    "date-fns": "^3.6.0",
    "devextreme": "^24.2.15",
    "devextreme-angular": "^24.2.15",
    "devextreme-schematics": "^1.6.9",
    "firebase": "^10.12.2",
    "ngx-cookie-service": "^19.1.0",
    "ngx-paypal": "^11.0.0",
    "rxjs": "~7.8.0",
    "shipengine": "^1.0.7",
    "stripe": "^16.7.0",
    "swiper": "^11.1.9",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@types/jasmine": "~4.3.0",
    "devextreme-cli": "latest",
    "devextreme-themebuilder": "23.2.6",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.3"
  }
}
